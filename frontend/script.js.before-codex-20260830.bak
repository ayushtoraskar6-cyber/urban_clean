        dashboard: [],
        selector: null,
        driver: [],
        admin: []
    },
    polylines: {
        driver: null,
        admin: null
    },
    tempUploadBase64: null,
    tempDriverUploadBase64: null,
    activeDriverJob: null,
    selectedAdminDriver: null
};

